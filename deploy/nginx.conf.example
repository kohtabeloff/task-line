# Образец настроек nginx. Замените домен и «секрет» на свои.
#
# Логика: страница открывается только по секретному адресу (/l/секрет/),
# на любой другой путь сервер отвечает «не найдено». Так задачи не увидит
# случайный человек, зашедший на ваш домен.
#
# Секрет — придумайте свою длинную строку из букв и цифр (например 10–12 знаков).
# Сам адрес нигде не публикуйте, просто добавьте страницу на домашний экран телефона.
#
# Не забудьте про HTTPS: проще всего получить бесплатный сертификат через certbot
# (он сам допишет нужные строки в этот файл).

server {
    listen 80;
    server_name ваш-домен.example.com;

    root /var/www/task-line;

    # Сама страница и иконка
    location /l/ВАШ-СЕКРЕТ/ {
        alias /var/www/task-line/;
        index index.html;
        add_header Cache-Control "no-store";
    }

    # Служба правок (кнопки «отметить / вернуть / добавить / переставить»)
    location /l/ВАШ-СЕКРЕТ/api/ {
        proxy_pass http://127.0.0.1:8040/api/;
        proxy_set_header Host $host;
        client_max_body_size 64k;
        proxy_read_timeout 30s;
    }

    # Всё остальное — «не найдено»
    location / {
        return 404;
    }
}